#!/bin/bash
BIN="$(dirname "$(readlink -f "$0")")"
. "$BIN/netwatch-config"
AWAY_RESET=600
REBOOT_CMD_TRIES=3

event() { printf '%s\t%s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }
probe() { /sbin/ping -c1 -t1 "$1" >/dev/null 2>&1; }
duration() { printf '%d분 %d초' $(($1 / 60)) $(($1 % 60)); }

# 카페 공유기도 192.168.0.1일 수 있어 MAC까지 맞아야 집으로 본다. 아니면 계정 정보를 보내지 않는다
is_home() {
  local gw mac
  gw=$(/sbin/route -n get default 2>/dev/null | awk '/gateway/{print $2}')
  [ "$gw" = "$ROUTER" ] && [ -s "$ROUTER_MAC_FILE" ] || return 1
  mac=$(/usr/sbin/arp -n "$ROUTER" | awk '{print $4}')
  [ "$mac" = no ] && probe "$ROUTER" && mac=$(/usr/sbin/arp -n "$ROUTER" | awk '{print $4}')
  [ "$mac" = "$(cat "$ROUTER_MAC_FILE")" ]
}

online() { probe 1.1.1.1 || probe 8.8.8.8; }

diagnose() {
  local up=FAIL dns=FAIL http
  if [ -n "$UPSTREAM" ]; then probe "$UPSTREAM" && up=ok; else up=-; fi
  # dig는 타임아웃 문구도 stdout으로 내보내므로 IP 형태의 응답만 성공으로 본다
  /usr/bin/dig +short +time=2 +tries=1 google.com 2>/dev/null | grep -Eq '^[0-9a-f.:]+$' && dns=ok
  http=$(/usr/bin/curl -s -m3 -o /dev/null -w '%{http_code}' http://captive.apple.com/hotspot-detect.html)
  echo "상위장비=$up DNS=$dns HTTP=$http"
}

keep_awake() {
  [ -n "$awake_pid" ] && kill -0 "$awake_pid" 2>/dev/null && return
  /usr/bin/caffeinate -is -w $$ &
  awake_pid=$!
}
let_sleep() {
  [ -n "$awake_pid" ] && kill "$awake_pid" 2>/dev/null
  awake_pid=
}

try_reboot() {
  local status out
  [ -n "$gave_up" ] && return
  if [ "$reboots" -eq 0 ]; then
    [ $((now - down_since)) -ge "$REBOOT_AFTER" ] || return
    if [ $((now - last_reboot)) -lt "$REBOOT_COOLDOWN" ]; then
      [ -z "$held" ] && event "끊김 지속 중이나 직전 재부팅 후 $((REBOOT_COOLDOWN / 60))분이 안 지나 재부팅 보류"
      held=1
      return
    fi
  else
    [ $((now - last_reboot)) -ge "$REBOOT_RETRY_AFTER" ] || return
    if [ "$reboots" -ge "$REBOOT_MAX" ]; then
      gave_up=1
      event "재부팅 ${reboots}번에도 복구 안 됨, 공유기 밖의 문제로 보고 재부팅 중단"
      return
    fi
  fi
  status=$("$BIN/iptime" status 2>&1)
  out=$("$BIN/iptime" reboot 2>&1)
  # 명령이 실패하면 공유기가 재부팅되지 않았으므로 횟수에 세지 않고 다음 확인 때 다시 보낸다
  if [[ "$out" == *'"done"'* ]]; then
    reboots=$((reboots + 1)) last_reboot=$now reboot_fails=0
    event "끊김 $(duration $((now - down_since))) 지속, 공유기 $status, 재부팅($reboots/$REBOOT_MAX) $out"
  else
    reboot_fails=$((reboot_fails + 1))
    event "재부팅 명령 실패($reboot_fails/$REBOOT_CMD_TRIES): $out"
    if [ "$reboot_fails" -ge "$REBOOT_CMD_TRIES" ]; then
      gave_up=1
      event "재부팅 명령이 계속 실패해 재부팅 중단"
    fi
  fi
}

reset_outage() { fails=0 down_since=0 reboots=0 reboot_fails=0 held= gave_up=; }

reset_outage
first_fail=0 last_reboot=0 away_since=0
while :; do
  now=$(date +%s)
  if ! is_home; then
    let_sleep
    if [ "$down_since" -gt 0 ]; then
      [ "$away_since" -eq 0 ] && away_since=$now
      # 재부팅 중에는 와이파이가 잠시 사라지므로 바로 추적을 끝내지 않는다
      if [ $((now - away_since)) -ge "$AWAY_RESET" ]; then
        event "집 네트워크에서 벗어나 끊김 추적 종료"
        reset_outage
      fi
    fi
    sleep "$INTERVAL"
    continue
  fi
  away_since=0
  keep_awake

  if online; then
    if [ "$down_since" -gt 0 ]; then
      d=$(duration $((now - down_since)))
      if [ "$reboots" -gt 0 ]; then
        event "복구됨: 총 $d 끊김, 자동 재부팅 ${reboots}번으로 복구"
        "$BIN/netwatch-notify" "[netwatch] 인터넷 복구됨. 총 $d 끊겼고 공유기를 자동 재부팅 ${reboots}번 해서 살렸습니다." &
      else
        event "복구됨: 총 $d 끊김, 저절로 회복"
      fi
    fi
    reset_outage
  else
    fails=$((fails + 1))
    # 한 번 실패는 패킷 손실일 수 있어 두 번 연속일 때부터 끊김으로 본다
    [ "$fails" -eq 1 ] && first_fail=$now
    if [ "$fails" -eq 2 ]; then
      down_since=$first_fail
      event "끊김 시작: $(diagnose)"
    fi
    [ "$down_since" -gt 0 ] && try_reboot
  fi
  sleep "$INTERVAL"
done

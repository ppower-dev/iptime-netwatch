# 다른 스크립트가 source하는 공통 설정
NETWATCH_DIR="$HOME/.config/netwatch"
[ -f "$NETWATCH_DIR/config" ] && . "$NETWATCH_DIR/config"
: "${ROUTER:=192.168.0.1}"
: "${UPSTREAM:=}"
: "${NOTIFY_TO:=}"
: "${KEYCHAIN_SERVICE:=iptime-admin}"
: "${INTERVAL:=10}"
: "${REBOOT_AFTER:=30}"
: "${REBOOT_COOLDOWN:=1800}"
: "${REBOOT_RETRY_AFTER:=300}"
: "${REBOOT_MAX:=2}"
ROUTER_MAC_FILE="$NETWATCH_DIR/router-mac"
LOG="$HOME/Library/Logs/netwatch.log"
